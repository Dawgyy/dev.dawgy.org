# SPA fallback for Apache.
# Copied verbatim into the deployed site so deep links (e.g. /work/appi)
# resolve when refreshed or shared — every non-file request serves the
# app shell and React Router takes over. No VPS reconfiguration needed.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files and directories as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else falls back to the SPA shell.
  RewriteRule ^ index.html [L]
</IfModule>

# Long-cache fingerprinted assets (Vite hashes filenames).
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Never cache the shell itself.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
